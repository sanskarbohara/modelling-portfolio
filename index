<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Sanskar — Model / Actor</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#0d0d0e;
    --ink-2:#151517;
    --bone:#f1ece1;
    --grey:#8b8880;
    --line: rgba(241,236,225,0.14);
    --crimson:#c22a1f;
    --crimson-dim: rgba(194,42,31,0.14);
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--ink);
    color:var(--bone);
    font-family:'Inter', sans-serif;
    overflow-x:hidden;
  }
  ::selection{ background:var(--crimson); color:var(--bone); }
  img{ display:block; }
  .mono{ font-family:'IBM Plex Mono', monospace; }
  a{ color:inherit; text-decoration:none; }

  /* ---------- NAV ---------- */
  nav{
    position:fixed; top:0; left:0; right:0; z-index:50;
    display:flex; justify-content:space-between; align-items:center;
    padding:22px clamp(20px,4vw,56px);
    mix-blend-mode:difference;
  }
  .nav-mark{ font-family:'Bebas Neue'; font-size:22px; letter-spacing:0.08em; }
  .nav-links{ display:flex; align-items:center; gap:28px; font-family:'IBM Plex Mono'; font-size:11px; letter-spacing:0.12em; text-transform:uppercase; }
  .nav-links a{ opacity:0.75; transition:opacity .25s; }
  .nav-links a:hover{ opacity:1; }
  .nav-book{
    border:1px solid var(--bone); padding:8px 16px; opacity:1 !important;
  }
  @media (max-width:640px){ .nav-links a.hide-mobile{display:none;} }

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    height:100vh;
    height:100svh;
    min-height:600px;
    display:flex;
    align-items:flex-end;
    overflow:hidden;
  }
  .hero img{
    position:absolute; inset:0;
    width:100%; height:100%;
    object-fit:cover;
    object-position:50% 15%;
    filter:contrast(1.08) saturate(0.98);
  }
  @media (min-width:860px){
    .hero img{ object-position:50% 8%; }
  }
  .hero::after{
    content:"";
    position:absolute; inset:0;
    background:linear-gradient(180deg, rgba(13,13,14,0.32) 0%, rgba(13,13,14,0.02) 30%, rgba(13,13,14,0.94) 100%);
  }
  .hero-content{
    position:relative; z-index:2;
    width:100%;
    padding:0 clamp(20px,4vw,56px) 48px;
    display:flex; justify-content:space-between; align-items:flex-end; gap:24px;
    flex-wrap:wrap;
  }
  .hero-status{
    display:inline-flex; align-items:center; gap:8px;
    font-family:'IBM Plex Mono'; font-size:11px; letter-spacing:0.14em; text-transform:uppercase;
    color:var(--grey); margin-bottom:18px;
  }
  .dot{ width:7px; height:7px; border-radius:50%; background:var(--crimson); box-shadow:0 0 0 3px var(--crimson-dim); }
  .hero-name{
    font-family:'Bebas Neue';
    font-size:clamp(72px,15vw,168px);
    line-height:0.82;
    letter-spacing:0.005em;
  }
  .hero-role{
    font-family:'IBM Plex Mono';
    font-size:12px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    color:var(--grey);
    margin-top:14px;
  }
  .hero-role span{ color:var(--crimson); }
  .hero-slate{
    font-family:'IBM Plex Mono';
    font-size:11px;
    letter-spacing:0.08em;
    text-align:right;
    color:var(--grey);
    line-height:1.9;
    text-transform:uppercase;
  }
  .hero-slate b{ color:var(--bone); font-weight:500; }
  .scroll-cue{
    position:absolute; bottom:20px; left:50%; transform:translateX(-50%);
    z-index:3;
    width:1px; height:34px;
    background:linear-gradient(180deg, transparent, var(--bone) 60%, transparent);
    opacity:0.5;
  }

  /* ---------- SECTION LABEL ---------- */
  .section{ padding:100px clamp(20px,4vw,56px); border-top:1px solid var(--line); }
  .section-label{
    display:flex; align-items:center; gap:14px;
    font-family:'IBM Plex Mono'; font-size:11px; letter-spacing:0.16em; text-transform:uppercase; color:var(--grey);
    margin-bottom:44px;
  }
  .section-label::before{ content:""; width:26px; height:1px; background:var(--crimson); }
  .section-header{
    display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap;
    margin-bottom:44px;
  }
  .section-header .section-label{ margin-bottom:0; }
  .btn-download{
    display:inline-flex; align-items:center; gap:9px;
    font-family:'IBM Plex Mono'; font-size:11px; letter-spacing:0.08em; text-transform:uppercase;
    color:var(--bone); border:1px solid var(--line);
    padding:11px 18px;
    transition:border-color .25s, color .25s;
  }
  .btn-download:hover{ border-color:var(--crimson); color:var(--crimson); }
  .btn-download svg{ width:12px; height:12px; }

  /* ---------- COMP CARD / STATS ---------- */
  .stats-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    border-top:1px solid var(--line);
    border-left:1px solid var(--line);
  }
  .stat-cell{
    border-right:1px solid var(--line);
    border-bottom:1px solid var(--line);
    padding:30px 22px;
  }
  .stat-cell .k{ font-family:'IBM Plex Mono'; font-size:10px; letter-spacing:0.14em; text-transform:uppercase; color:var(--grey); margin-bottom:14px; }
  .stat-cell .v{ font-family:'Bebas Neue'; font-size:clamp(28px,3.4vw,44px); }
  @media (max-width:760px){ .stats-grid{ grid-template-columns:repeat(2,1fr); } }

  .bio-row{
    display:grid; grid-template-columns:1fr 1.3fr; gap:60px;
    margin-top:70px;
  }
  .bio-row .eyebrow{ font-family:'IBM Plex Mono'; font-size:11px; letter-spacing:0.14em; text-transform:uppercase; color:var(--grey); }
  .bio-row p{ font-size:clamp(20px,2.4vw,28px); line-height:1.5; font-weight:400; letter-spacing:-0.01em; }
  .bio-row p b{ font-weight:600; color:var(--bone); }
  @media (max-width:760px){ .bio-row{ grid-template-columns:1fr; gap:22px; } }

  /* ---------- CONTACT SHEET GALLERY ---------- */
  .sprocket-row{ display:flex; justify-content:space-between; padding:0 2px; margin-bottom:6px; }
  .sprocket-row span{ width:8px; height:8px; border-radius:1px; background:var(--line); }
  .filmstrip{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:2px;
    background:var(--line);
    border:1px solid var(--line);
  }
  .frame{
    position:relative;
    aspect-ratio:3/4;
    overflow:hidden;
    background:#000;
  }
  .frame img{
    width:100%; height:100%; object-fit:cover;
    filter:grayscale(100%) contrast(1.08);
    transform:scale(1.01);
    transition:filter .5s ease, transform .6s ease;
  }
  .frame:hover img{ filter:grayscale(0%) contrast(1.02); transform:scale(1.05); }
  .frame-tag{
    position:absolute; top:10px; left:10px;
    font-family:'IBM Plex Mono'; font-size:10px; letter-spacing:0.1em;
    color:var(--bone); background:rgba(13,13,14,0.55);
    padding:3px 7px;
    backdrop-filter:blur(2px);
  }
  .frame-tag b{ color:var(--crimson); }
  @media (max-width:700px){ .filmstrip{ grid-template-columns:repeat(2,1fr); } }

  /* ---------- CREDITS ---------- */
  .credit-row{
    display:flex; justify-content:space-between; align-items:baseline;
    padding:26px 0; border-bottom:1px solid var(--line);
    gap:20px; flex-wrap:wrap;
  }
  .credit-row:first-of-type{ border-top:1px solid var(--line); }
  .credit-name{ font-family:'Bebas Neue'; font-size:clamp(30px,4vw,52px); letter-spacing:0.01em; }
  .credit-role{ font-family:'IBM Plex Mono'; font-size:12px; letter-spacing:0.08em; text-transform:uppercase; color:var(--grey); text-align:right; max-width:340px; }

  /* ---------- SKILLS ---------- */
  .skills-wrap{ display:flex; flex-wrap:wrap; gap:12px; }
  .chip{
    font-family:'IBM Plex Mono'; font-size:12px; letter-spacing:0.06em; text-transform:uppercase;
    border:1px solid var(--line); padding:10px 18px;
    color:var(--bone);
  }
  .chip.accent{ border-color:var(--crimson); color:var(--crimson); }

  /* ---------- REEL ---------- */
  .reel-frame{
    position:relative;
    aspect-ratio:16/9;
    border:1px solid var(--line);
    background:var(--ink-2);
    display:flex; align-items:center; justify-content:center;
    overflow:hidden;
  }
  .reel-frame iframe, .reel-frame video{
    position:absolute; inset:0; width:100%; height:100%; border:0;
  }
  .reel-placeholder{
    display:flex; flex-direction:column; align-items:center; gap:16px;
    text-align:center; padding:20px;
  }
  .reel-play{
    width:52px; height:52px; border:1px solid var(--line); border-radius:50%;
    display:flex; align-items:center; justify-content:center;
  }
  .reel-play svg{ width:16px; height:16px; fill:var(--grey); margin-left:2px; }
  .reel-placeholder .t1{ font-family:'Bebas Neue'; font-size:24px; letter-spacing:0.02em; color:var(--bone); }
  .reel-placeholder .t2{ font-family:'IBM Plex Mono'; font-size:11px; letter-spacing:0.06em; color:var(--grey); max-width:38ch; }

  /* ---------- CONTACT / FOOTER ---------- */
  footer{
    padding:90px clamp(20px,4vw,56px) 40px;
    border-top:1px solid var(--line);
  }
  .contact-big{
    font-family:'Bebas Neue';
    font-size:clamp(24px,7vw,92px);
    line-height:1.05;
    letter-spacing:0.01em;
    overflow-wrap:anywhere;
    word-break:break-word;
  }
  .contact-big a{ border-bottom:2px solid transparent; transition:border-color .25s; }
  .contact-big a:hover{ border-color:var(--crimson); }
  .contact-meta{
    display:flex; justify-content:space-between; align-items:flex-end;
    margin-top:50px; flex-wrap:wrap; gap:20px;
    font-family:'IBM Plex Mono'; font-size:11px; letter-spacing:0.1em; text-transform:uppercase; color:var(--grey);
  }
  .contact-meta a{ color:var(--bone); }
  .contact-meta a:hover{ color:var(--crimson); }

  @media (prefers-reduced-motion: reduce){
    *{ transition:none !important; scroll-behavior:auto !important; }
  }

  a:focus-visible, .frame:focus-visible{ outline:2px solid var(--crimson); outline-offset:3px; }

  /* ---------- MOBILE REFINEMENTS ---------- */
  @media (max-width:640px){
    .section{ padding:64px 20px; }
    .hero-slate{ display:none; }
    .hero-content{ padding-bottom:36px; }
    .hero-status{ margin-bottom:14px; }
    .section-header{ gap:14px; }
    .credit-row{ flex-direction:column; align-items:flex-start; gap:6px; }
    .credit-role{ text-align:left; max-width:none; }
    .stat-cell{ padding:22px 16px; }
    .bio-row{ margin-top:44px; }
    footer{ padding:64px 20px 32px; }
    .contact-meta{ flex-direction:column; align-items:flex-start; gap:12px; margin-top:34px; }
  }
</style>
</head>
